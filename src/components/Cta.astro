---
import { cta } from '../config';
---

<section class="cta" id={cta.id} aria-labelledby="cta-title">
  <div class="container container--narrow">
    <h2 id="cta-title">{cta.title}</h2>
    <p>{cta.text}</p>
    <a class="btn btn--light" href={cta.button.href}>{cta.button.label}</a>
  </div>
</section>
